rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // DIALLO HRMS — PHASES 1 to 10 COLLECTIONS:
    // users, roles, companies, branches, departments, designations, grades, costCenters,
    // employees, employeeHistory, onboardingTasks, employeeExits, attendanceRecords, punchLogs,
    // attendanceSettings, attendanceRegularizations, leaveApplications, leaveBalances, leaveTypes,
    // holidays, salaryStructures, payrollRuns, payslips, approvalRequests, goals, reviewCycles,
    // performanceReviews, 360Feedback, jobRequisitions, jobPositions, candidates, jobApplications,
    // interviewFeedback, jobOffers, announcements, notifications, auditLogs,
    // expenses, expenseCategories, expensePolicies, expenseApprovals,
    // assets, assetCategories, assetAssignments, assetReturns, assetMaintenance, vendors

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
