# ==============================================================================
# DIALLO HRMS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Enterprise Suite Environment Variables (Firebase Cloud Architecture)
# ==============================================================================

# Application Metadata
APP_NAME="Diallo HRMS Enterprise"
APP_ENV="development"
APP_URL="http://localhost:5500"
APP_VERSION="14.0.0"

# Default Organization & Localization
DEFAULT_COMPANY_ID="comp_diallo_india"
DEFAULT_COMPANY_NAME="Diallo India Private Limited"
DEFAULT_COUNTRY="India"
DEFAULT_CURRENCY="INR"
DEFAULT_TIMEZONE="Asia/Kolkata"

# Firebase Cloud Architecture Credentials
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
FIREBASE_APP_ID="YOUR_APP_ID"
FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Module Feature Flags (Phases 1 to 14)
ENABLE_RBAC=true
ENABLE_MULTI_COMPANY=true
ENABLE_GEOLOCATION_PUNCH=true
ENABLE_PAYROLL_STATUTORY=true
ENABLE_EXPENSE_MANAGEMENT=true
ENABLE_ASSET_TRACKING=true
ENABLE_DOCUMENT_MANAGEMENT=true
ENABLE_EMPLOYEE_SELF_SERVICE=true
ENABLE_ANALYTICS_REPORTS=true
ENABLE_NOTIFICATIONS_PUSH=true
ENABLE_WORKFLOW_AUTOMATION=true

# Notification & Cloud Messaging
FCM_VAPID_KEY=""
NOTIFICATION_EMAIL_SENDER="no-reply@diallo-hrms.com"
