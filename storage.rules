rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCompanyMember(companyId) {
      return isAuthenticated();
    }

    function isOwner(employeeId) {
      return isAuthenticated() && request.auth.uid == employeeId;
    }

    // Company branding (Logos)
    match /companies/{companyId}/branding/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isCompanyMember(companyId);
    }

    // Company policies & documents
    match /companies/{companyId}/policies/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isCompanyMember(companyId);
    }

    // Employee specific documents, letters, and certificates
    match /companies/{companyId}/employees/{employeeId}/{allPaths=**} {
      allow read: if isOwner(employeeId) || isCompanyMember(companyId);
      allow write: if isOwner(employeeId) || isCompanyMember(companyId);
    }

    // Fallback authenticated rule
    match /{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
